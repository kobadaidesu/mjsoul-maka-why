#!/bin/sh
# maka — 専用 Chrome を起動して雀魂の牌譜スキャン (mjcap ingest) を始める。
# 追加引数はそのまま ingest へ渡る (例: scripts/maka --plain)。
#
# 環境変数:
#   MJCAP_CHROME          Chrome 実行ファイル (既定: macOS の Google Chrome)
#   MJCAP_CHROME_PROFILE  専用プロファイル (既定: ~/.local/share/mjcap/chrome-profile)
set -eu

root="$(cd "$(dirname "$0")/.." && pwd)"
port=9222
chrome="${MJCAP_CHROME:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
profile="${MJCAP_CHROME_PROFILE:-$HOME/.local/share/mjcap/chrome-profile}"

if [ ! -x "$root/bin/mjcap" ]; then
    echo "[err] bin/mjcap がありません" >&2
    echo "      対処: リポジトリで make build を実行してください" >&2
    exit 1
fi

# 既にデバッグ用 Chrome で雀魂が開いていれば起動をスキップする。
if ! curl -s --max-time 2 "http://127.0.0.1:$port/json/list" 2>/dev/null | grep -q mahjongsoul; then
    if [ ! -x "$chrome" ]; then
        echo "[err] Chrome が見つかりません: $chrome" >&2
        echo "      対処: MJCAP_CHROME=/path/to/chrome で指定するか、README の手動起動コマンドを使ってください" >&2
        exit 1
    fi
    "$chrome" --remote-debugging-address=127.0.0.1 --remote-debugging-port="$port" \
        --user-data-dir="$profile" "https://game.mahjongsoul.com/" >/dev/null 2>&1 &
    sleep 2
fi

cd "$root"
exec ./bin/mjcap ingest "$@"
